<section class="container g-pt-50">
      <div class="mb-5">
        <h2 class="h3 g-color-black mb-0">TROPIALIS AFFILIATES PROGRAM</h2>
        <div class="d-inline-block g-width-50 g-height-1 g-bg-black"></div>
      </div>

      <div class="row">
        
      </div>
        
</section>

<!-- Login -->
    <section class="container">
      <div class="row justify-content-center">
        <div class="col-sm-10 col-md-9 col-lg-6">
          <div class="g-brd-around g-brd-gray-light-v4 rounded g-py-40 g-px-30">

            <!-- Form -->
            <form class="g-py-15" id="form_affiliate_login">

              <div class="mb-4">
                <label class="g-color-gray-dark-v2 g-font-weight-600 g-font-size-13">Email:</label>
                <input name="email" class="form-control g-color-black g-bg-white g-bg-white--focus g-brd-gray-light-v4 g-brd-primary--hover rounded g-py-15 g-px-15" type="email" placeholder="">
              </div>

              <div class="row">
                <div class="col-lg-12 col-xs-12 col-sm-12 mb-4">
                  <label class="g-color-gray-dark-v2 g-font-weight-600 g-font-size-13">Password:</label>
                  <input name="password" class="form-control g-color-black g-bg-white g-bg-white--focus g-brd-gray-light-v4 g-brd-primary--hover rounded g-py-15 g-px-15" type="password" placeholder="">
                </div>

              </div>

              <div class="row justify-content-between mb-5">
                <div class="col-lg-12 col-12 text-left">
                  <button id="loginaffiliate" class="btn btn-md u-btn-primary rounded g-py-13 g-px-25" type="button">Login</button>
                </div>
              </div>
            </form>
            <!-- End Form -->

            <footer class="text-center">
              <p class="g-color-gray-dark-v5 g-font-size-13 mb-0">Don't have an account? <a class="g-font-weight-600" href="{{ url() }}page/affiliatesjoin/">signup</a>
              </p>
            </footer>
          </div>
        </div>
      </div>
    </section>
    <!-- End Login -->
